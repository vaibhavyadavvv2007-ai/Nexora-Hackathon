{
  "project_name": "nexora",
  "project_title": "Nexora - Smart Shortlisting Engine",
  "hackathon": "InternLoom AI Hackathon",
  "workflow": "gsd",
  "tech_stack": {
    "backend": "python",
    "pdf_extraction": "PyMuPDF (fitz)",
